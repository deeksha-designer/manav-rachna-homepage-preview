	<script>
	jQuery(document).ready(function($){
		var csrfToken = "808ea46fc7bfee39f7bf9b5bba6abc44";
		$.ajaxSetup({
			headers: {
				'X-CSRF-TOKEN': csrfToken
			}
		});

		$(document).on('change', '#fac_school', function() {

			var schoolselected = $('#fac_school').val();
			var campusselected = $('#campus').val();
			$.ajax({
				url: 'https://manavrachna.edu.in/department_filter',
				type: 'POST',
				data: {
					campusselected: campusselected,
					schoolselected: schoolselected,
					csrf_test_name: csrfToken,
				},
				success: function(response) {
					$('#department_append').html(response.department);

					console.log(response);
				},
				error: function(xhr, status, error) {}
			});

		});

		$(document).on('change', '#campus', function() {
			var campusselected = $('#campus').val();
			$('#school_append').html('');
			$('#department_append').html('');

			$.ajax({
				url: 'https://manavrachna.edu.in/school_department_filter',
				type: 'POST',
				data: {
					campusselected: campusselected,
					csrf_test_name: csrfToken,
				},
				success: function(response) {
					$('#school_append').html(response.school);
					$('#department_append').html(response.department);
				},
				error: function(xhr, status, error) {}
			});
		});












		$(document).ready(function() {
			// Get the current URL
			var currentUrl = window.location.href;
			// Loop through each anchor tag in the menu
			$('.dropdown_menu a').each(function() {
				// Check if the href attribute matches the current URL
				if ($(this).attr('href') === currentUrl) {
					// Add the "active" class to the parent <li>
					$(this).addClass('active');
					$(this).parent('li').addClass('active');
					$(this).closest('li.dropdown_menu').addClass('active');
				}
			});
		});


		$(document).ready(function() {

			$('.program_course_list_menu a').click(function() {
				$('#course ul li:first-child').addClass('active');
				var linkAccordian = $('#course ul li:first-child a').attr('data-target');

				$(linkAccordian).addClass('active');
