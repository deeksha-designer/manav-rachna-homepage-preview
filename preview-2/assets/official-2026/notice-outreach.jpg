	<header>


<div class="headerTopSlider position-relative">
    <div id="carouselExampleAutoplaying" class="carousel slide" data-bs-ride="carousel">
        
        <div class="carousel-inner text-center" id="announcementCarousel">
            
            <!-- ✅ Instant fallback content (no loading delay) -->
            <div class="carousel-item active">
                <div class="announce_text">
                    <p>Welcome! Stay updated with our latest announcements.</p>
                </div>
            </div>

        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="prev" aria-label="Previous announcement">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        </button>

        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="next" aria-label="Previous announcement">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
        </button>

    </div>
</div>

<!-- ✅ Optional: preload API for faster fetch -->
<link rel="preload" as="fetch" href="https://manavrachna.edu.in/api/announcements" crossorigin="anonymous">

<script>
// ✅ Call immediately (no DOMContentLoaded delay)
loadAnnouncements();

function loadAnnouncements() {
    const apiUrl = 'https://manavrachna.edu.in/api/announcements';

    // ✅ 1. Load cached announcements instantly
    const cached = localStorage.getItem('announcements');
    if (cached) {
        try {
            const parsed = JSON.parse(cached);
            if (parsed.length > 0) {
                displayAnnouncements(parsed);
            }
        } catch (e) {
            console.warn('Cache parse error:', e);
        }
    }

    // ✅ 2. Fetch latest announcements in background
    fetch(apiUrl)
        .then(response => response.json())
        .then(data => {
            if (data.success && data.announcements && data.announcements.length > 0) {

                // Save latest data to cache
                localStorage.setItem('announcements', JSON.stringify(data.announcements));

                // Update UI with fresh data
                displayAnnouncements(data.announcements);

            } else {
                document.querySelector('.headerTopSlider').style.display = 'none';
            }
        })
        .catch(error => {
            console.error('Error loading announcements:', error);
        });
}

function displayAnnouncements(announcements) {
    const carouselInner = document.getElementById('announcementCarousel');
    carouselInner.innerHTML = ''; // Clear existing content

    announcements.forEach((announcement, index) => {

        const carouselItem = document.createElement('div');
        carouselItem.className = 'carousel-item' + (index === 0 ? ' active' : '');
        carouselItem.setAttribute('data-bs-interval', '3000');

        const announceText = document.createElement('div');
        announceText.className = 'announce_text';

        const paragraph = document.createElement('p');
        paragraph.textContent = announcement.title;
        announceText.appendChild(paragraph);

        // ✅ Add button if exists
        if (announcement.button_text && announcement.button_link) {
            const link = document.createElement('a');
            link.href = announcement.button_link;
            link.target = '_blank';
            link.className = 'xs-btn text-white btn-hoverEffect';
            link.textContent = announcement.button_text;

            announceText.appendChild(document.createTextNode(' '));
            announceText.appendChild(link);
        }

        carouselItem.appendChild(announceText);
        carouselInner.appendChild(carouselItem);
    });

    // ✅ Reinitialize Bootstrap carousel
    const carouselElement = document.getElementById('carouselExampleAutoplaying');

    if (typeof bootstrap !== 'undefined') {

        // Destroy previous instance if exists (important)
        if (bootstrap.Carousel.getInstance(carouselElement)) {
            bootstrap.Carousel.getInstance(carouselElement).dispose();
        }

        new bootstrap.Carousel(carouselElement, {
            interval: 3000,
            ride: 'carousel',
            pause: false,
            wrap: true
        });
    }
}
</script>

