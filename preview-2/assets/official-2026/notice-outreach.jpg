<script>
(function () {
var deadline = new Date('2026-07-02T23:59:59+05:30');
    function pad(n) { return String(Math.max(0, n)).padStart(2, '0'); }
    
    function tick() {
        var diff = deadline - new Date();
        if (diff <= 0) {
            document.getElementById('mr-popup').style.display = 'none';
            return;
        }
        document.getElementById('p-d').textContent = pad(Math.floor(diff / 864e5));
        document.getElementById('p-h').textContent = pad(Math.floor(diff % 864e5 / 36e5));
        document.getElementById('p-m').textContent = pad(Math.floor(diff % 36e5 / 6e4));
        document.getElementById('p-s').textContent = pad(Math.floor(diff % 6e4 / 1e3));
    }

    document.addEventListener("DOMContentLoaded", function () {
        tick();
        setInterval(tick, 1000);

        var ONE_HOUR = 60 * 60 * 1000;
        var now = Date.now();
        var sameSession = sessionStorage.getItem('mrnat_session');
        var closedAt = localStorage.getItem('mrnat_closed_at');
        var popup = document.getElementById('mr-popup');

        if (!sameSession) {
            localStorage.removeItem('mrnat_closed_at');
            popup.style.display = 'block';
            popup.classList.add('show');
        } else {
            if (!closedAt || (now - parseInt(closedAt)) > ONE_HOUR) {
                popup.style.display = 'block';
                popup.classList.add('show');
            }
        }

        sessionStorage.setItem('mrnat_session', '1');

        document.getElementById('mr-close').addEventListener('click', function () {
            popup.classList.remove('show');
            popup.style.display = 'none';
            localStorage.setItem('mrnat_closed_at', now.toString());
        });
    });
})();
</script>

  <script>
    function sw(group, id, el) {
      ['ug', 'pg'].forEach(k => { var p = document.getElementById(group + '-' + k); if (p) p.classList.remove('on') });
      el.parentElement.querySelectorAll('.tab').forEach(b => b.classList.remove('on'));
      var t = document.getElementById(group + '-' + id); if (t) t.classList.add('on');
      el.classList.add('on');
    }
    function tf(item) {
      var open = item.classList.contains('open');
      document.querySelectorAll('.fitem.open').forEach(f => f.classList.remove('open'));
      if (!open) item.classList.add('open');
    }
  </script>
<script>
    // Programme tabs
    function switchProg(tab, el) {
      document.querySelectorAll('.prog-panel').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.prog-tab').forEach(t => t.classList.remove('active'));
      document.getElementById('prog-' + tab).classList.add('active');
      el.classList.add('active');
      // re-trigger fade-up
      document.querySelectorAll('#prog-' + tab + ' .fade-up').forEach((el, i) => {
        el.classList.remove('visible');
        setTimeout(() => el.classList.add('visible'), i * 80);
      });
    }

    // Exam tabs
    function switchExam(tab, el) {
      document.querySelectorAll('.exam-panel').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.exam-tab').forEach(t => t.classList.remove('active'));
      document.getElementById('ep-' + tab).classList.add('active');
      el.classList.add('active');
    }

    // FAQ
    function toggleFaq(el) {
      const item = el.closest('.faq-item');
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    }

    // Intersection observer for fade-up
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
    }, { threshold: 0.08 });
    document.querySelectorAll('.fade-up').forEach(el => io.observe(el));
  </script>
  
  <script>
  // ==========================================
    // 1. SLIDE-OUT PANEL LOGIC (Toggle, Outside Click & Scroll)
    // ==========================================
    const swOpenBtn = document.getElementById('sw-openPanelBtn');
    const swCloseBtn = document.getElementById('sw-popup-close');
    const swPanel = document.getElementById('sw-whatsNewPanel');

    // A. Default Open on page load
    window.addEventListener('DOMContentLoaded', () => {
        swPanel.classList.add('open');
    });
// B. Button click par toggle
    swCloseBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        swPanel.classList.toggle('open');
    });
    // B. Button click par toggle
    swOpenBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        swPanel.classList.toggle('open');
    });

    // C. Click outside to close
    document.addEventListener('click', (e) => {
        if (!swPanel.contains(e.target) && e.target !== swOpenBtn) {
            swPanel.classList.remove('open');
        }
    });

    // D. Scroll behavior: Close on scroll down, open on top
    window.addEventListener('scroll', () => {
        if (window.scrollY > 50) {
            swPanel.classList.remove('open');
        } else {
            swPanel.classList.add('open');
        }
    });

    // ==========================================
    // 2. TIMERS & AUTOMATIC SLIDER LOGIC
    // ==========================================
    const widgetRoot = document.getElementById('slideoutWidgetMain');

    /* --- Countdown Timer --- */
    function pad(n){return String(n).padStart(2,"0")}

    function tick(){
      const timerBar = widgetRoot.querySelector(".timerbar");
      if (!timerBar) return;

      const target = new Date(timerBar.dataset.deadline).getTime();
      let diff = target - Date.now();
      if(diff < 0) diff = 0;

      const d = Math.floor(diff / 86400000);
      const h = Math.floor(diff % 86400000 / 3600000);
      const m = Math.floor(diff % 3600000 / 60000);
      const s = Math.floor(diff % 60000 / 1000);

      timerBar.querySelector("[data-d]").textContent = pad(d);
      timerBar.querySelector("[data-h]").textContent = pad(h);
      timerBar.querySelector("[data-m]").textContent = pad(m);
      timerBar.querySelector("[data-s]").textContent = pad(s);
    }
    tick();
    setInterval(tick, 1000);

    /* --- Pure Autoplay Slider --- */
    const track  = document.getElementById("cuet-track");
    const slides = track.children.length;
    const dotsEl = document.getElementById("cuet-dots");
    let index = 0;
    let autoplay;

    for(let i=0;i<slides;i++){
      const b = document.createElement("button");
      b.className = "dot" + (i===0 ? " active" : "");
      b.addEventListener("click", ()=>goTo(i));
      dotsEl.appendChild(b);
    }
    const dots = [...dotsEl.children];

    function render(){
      track.style.transform = `translateX(-${index*100}%)`;
      dots.forEach((d,i)=>d.classList.toggle("active", i===index));
    }
    function goTo(i){ index = (i+slides)%slides; render(); restart(); }
    function next(){ goTo(index+1); }
    function prev(){ goTo(index-1); }

    function start(){ autoplay = setInterval(next, 3500); }
    function restart(){ clearInterval(autoplay); start(); }
    start();

    const slider = document.getElementById("cuet-slider");
    slider.addEventListener("mouseenter", ()=>clearInterval(autoplay));
    slider.addEventListener("mouseleave", start);

    let startX = null;
    slider.addEventListener("touchstart", e=>startX = e.touches[0].clientX, {passive:true});
    slider.addEventListener("touchend", e=>{
      if(startX===null) return;
      const dx = e.changedTouches[0].clientX - startX;
      if(Math.abs(dx) > 40) (dx < 0 ? next : prev)();
      startX = null;
    });
</script>
  
  
