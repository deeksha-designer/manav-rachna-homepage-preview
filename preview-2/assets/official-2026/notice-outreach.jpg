			});
		})




		function openDiv(divid) {
			window.location.href = window.location.href.split("#")[0] + divid;
			history.pushState(null, "", window.location.href.split("#")[0]);
		}

		$('#searchform').on('click', function() {
			var searchInput = document.getElementById('searchInput').value;
			// Check if the length of the search input is greater than 3
			if (searchInput.length < 3) {
				// Display an alert or error message
				$('#searchInput').val('Please enter at least 3 characters for the search.');
				// alert('Please enter at least 4 characters for the search.');
				// Prevent form submission
				if (event.preventDefault) {
					event.preventDefault(); // For modern browsers
				} else {
					event.returnValue = false; // For IE
				}
				return false;
			}
			return true; // Allow form submission if input length is valid
		});
	});
	</script>
	
