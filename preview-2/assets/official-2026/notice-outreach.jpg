<script>
    function animateCounter(el, target, speed = 20) {
      let count = 0;
      const step = Math.ceil(target / 100);
  
      const update = () => {
        count += step;
        if (count >= target) {
          el.textContent = target + '+';
        } else {
          el.textContent = count + '+';
          requestAnimationFrame(update);
        }
      };
      update();
    }
  
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const h3 = entry.target;
          const target = parseInt(h3.getAttribute('data-count'));
          animateCounter(h3, target);
          observer.unobserve(h3); // Run only once
        }
      });
    }, { threshold: 0.6 });
  
    document.querySelectorAll('.stat-item h3').forEach(h3 => {
      observer.observe(h3);
    });
  </script>
