	// The nopaperforms "Enquire Now" widget pulls in its own jQuery/Bootstrap/crypto
	// bundle (~100KB), duplicating libraries this page already loads. It only fills
	// in the .npf_wgts panel, which stays closed until the user opens it, so load it
	// on first interaction instead of on every page load.
	(function () {
		var npfLoaded = false;
		function loadNpf() {
			if (npfLoaded) return;
			npfLoaded = true;
			window.removeEventListener('scroll', loadNpf);
			window.removeEventListener('mousemove', loadNpf);
			window.removeEventListener('touchstart', loadNpf);
			window.removeEventListener('keydown', loadNpf);
			var s = document.createElement("script");
			s.type = "text/javascript";
			s.async = true;
			s.src = "https://widgets.nopaperforms.com/emwgts.js";
			document.body.appendChild(s);
		}
		window.addEventListener('scroll', loadNpf, { passive: true });
		window.addEventListener('mousemove', loadNpf, { passive: true });
		window.addEventListener('touchstart', loadNpf, { passive: true });
		window.addEventListener('keydown', loadNpf, { passive: true });
	})();
	</script>


