<section class="home_banner video-banner">

  <!-- DESKTOP VIDEO -->
  <div class="banner-img home-video-lg">
    <video class="home-video"
           playsinline autoplay muted loop preload="none"
           id="theplayer"
           poster="https://manavrachna.edu.in/uploads/home/banner_images/6571736d536a11701933933.webp"
           aria-label="Manav Rachna campus background video">
      <source data-src="https://manavrachna.edu.in/assets/videos/home_video (1).mp4" type="video/mp4">
      <track kind="captions" src="https://manavrachna.edu.in/assets/videos/empty.vtt" srclang="en" label="English" default>
    </video>
  </div>

  <!-- MOBILE VIDEO -->
  <div class="mobile-banner">
    <div class="banner-img home-video-mobile">
      <video class="home-video"
             playsinline autoplay muted loop preload="none"
             id="theplayer-mobile"
             poster="https://manavrachna.edu.in/uploads/home/banner_images/6a9a65b21e1111788503474.webp"
             aria-label="Manav Rachna campus background video">
        <source data-src="https://manavrachna.edu.in/assets/videos/2-video_ont9hO4E.mp4" type="video/mp4">
        <track kind="captions" src="https://manavrachna.edu.in/assets/videos/empty.vtt" srclang="en" label="English" default>
      </video>
    </div>
  </div>

  <script>
  // Defers the multi-megabyte video source assignment so it doesn't compete with
  // the initial page load. The poster image paints immediately for LCP; the real
  // video swaps in shortly after via a short timeout (fixed from an earlier
  // window.load-based version that inflated LCP "element render delay" to 10s+
  // under throttled conditions).
  (function () {
    function loadActiveBannerVideo() {
      var isMobile = window.matchMedia('(max-width: 768px)').matches;
      var video = document.getElementById(isMobile ? 'theplayer-mobile' : 'theplayer');
      if (!video || video.dataset.srcLoaded) return;
      var source = video.querySelector('source[data-src]');
      if (source) {
        source.setAttribute('src', source.getAttribute('data-src'));
      }
      video.dataset.srcLoaded = 'true';
      video.load();
      var playPromise = video.play();
      if (playPromise && playPromise.catch) playPromise.catch(function () {});
    }
    setTimeout(loadActiveBannerVideo, 100);
  })();
  </script>

