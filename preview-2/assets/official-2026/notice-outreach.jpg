<script>
(function() {
  function initHomeJS() {
    if (window.jQuery && typeof $.fn.modal === 'function') {
      $('#overlay').modal('show');
      setTimeout(function() { $('#overlay').modal('hide'); }, 5000);
    }

    $("#search_course").keyup(function() {
      var filter = $(this).val().toLowerCase();
      $(".searchable ul li").each(function() {
        var listItemText = $(this).text().toLowerCase().replace(/[^\w\s]/g, '');
        $(this).toggle(listItemText.search(new RegExp(filter, "i")) >= 0);
      });
    });

    $("#search_course").focus(function() {
      $(this).closest(".searchable").find("ul, ul li").show();
    });

    $("#search_course").blur(function() {
      let that = this;
      setTimeout(function() {
        $(that).closest(".searchable").find("ul").hide();
      }, 200);
    });

    $(document).on('click', '.searchable ul li', function() {
      window.location = $(this).find('a').attr('href');
    });

    $(".searchable ul li").hover(function() {
      $(this).closest(".searchable").find("ul li.selected").removeClass("selected");
      $(this).addClass("selected");
    });

    // =====================================================
    // VIDEO AUTOPLAY - source tags now in HTML directly
    // so browser loads them natively without JS delay.
    // We only need to ensure play() is called.
    // =====================================================
    var videos = [
      document.getElementById('theplayer'),
      document.getElementById('theplayer-mobile')
    ];
    videos.forEach(function(video) {
      if (video) {
        video.play().catch(function(e) {
          console.log("Autoplay was prevented:", e);
        });
      }
    });
  }

  if (window.jQuery) {
    initHomeJS();
  } else {
    var interval = setInterval(function() {
      if (window.jQuery) {
        clearInterval(interval);
        initHomeJS();
      }
    }, 50);
  }
})();
</script>

