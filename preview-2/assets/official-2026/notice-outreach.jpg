                        font-size: 12px;
                        background-color:rgb(178, 43, 46);
                        color:#fff;
                        padding: 12px 21px;
                        width: max-content;
                        z-index:9999999999;
                    }
                    .mysidebtnimp.student_chat_sm.phaseBtn{
                        left:0 !important;
                        right:auto !important;
                    }
                    .mysidebtnimp.student_chat_sm.phaseBtn a {
                        transform-origin: bottom left;
                        transform: rotate(90deg);
                        right: auto !important;
                        left: 0 !important;
                        top: -113%;
                        bottom: auto;
                        text-align:center;
                        background-color:#37008E;
                        font-size: clamp(10px, 1vw, 14px) !important;
                        text-transform: uppercase;
                        display:none;
                    }
                    .flicker {
                        background-color: #37008E;
                        color: #fff;
                        border: 0;
                        outline: 0;
                        animation: wink 1.25s linear infinite;
                      }
                      .flicker:active {
                        animation: none;
                      }
                    @keyframes wink {
                      50% {background-color: #FD5E53 ; color: #fff; opacity: 1;}
                    }
                    .mobContainer {
                        display:none;
                    }
            
                @media(max-width:1199px){
                    .mysidebtnimp.student_chat_sm.phaseBtn {
                        transform: rotate(90deg);
                        transform-origin: bottom left;
                        position: fixed;
                        left: 10px !important;
                        right: auto !important;
                    }
                    .mysidebtnimp.student_chat_sm{
                        position:unset;
                    }
                    .enquiry-panel {
                        width: max-content;
                        margin-right:-20px;
                    }
                    .home_enquiry.footer-fix-enquiry {
                        position: fixed;
                        top: 25%;
                    }
                    .enquiry-panel {
                        gap: 10px;
                    }
                    .applynowmobile, .enquiry-panel h2 {
                        position: unset;
                    }
                    .applynowmobile .applybutton a {
                        color: #fff;
                        padding: 12px 21px;
                    }
                    .mysidebtnimp.student_chat_sm a {
                        position: unset !important;
                        transform: unset !important;
                    }
                    .mysidebtnimp.student_chat_sm {
                        position: unset;
                        transform: unset;
                    }
                    .home_enquiry.footer-fix-enquiry {
                        position: fixed;
                        top: 40dvh;
                    }
                }
                @media(max-width:991px){
                    .mysidebtnimp.student_chat_sm.phaseBtn a{
                        display:none;
                    }
                    .mysidebtnimp.student_chat_sm.phaseBtn.mobContainer {
                        position: unset !important;
                        transform: unset !important;
                    }
                    .mobContainer{
                        display:block;
                    }
                    .deskContainer{
                        display:none;
                    }
                    .mysidebtnimp.student_chat_sm:not(.phaseBtn){
                        display:none;
                    }
                    .mysidebtnimp.student_chat_sm.phaseBtn {
                        transform: rotate(-90deg)  !important;
                        transform-origin: bottom right !important;
                        right: 8px !important;
                        left: auto !important;
                        top:10dvh;
                        bottom:auto !important;
                        width:max-content;
                    }
                    /*.mysidebtnimp.student_chat_sm.phaseBtn a {*/
                    /*    display: flex;*/
                    /*    flex-wrap: wrap;*/
                    /*    max-width: 120px;*/
                    /*}*/
                }
                
                /*@media(max-width:575px){*/
                /*    .mysidebtnimp.student_chat_sm.phaseBtn {*/
                /*            transform: rotate(90deg)  !important;*/
                /*            transform-origin: bottom left !important;*/
                /*            position: fixed !important;*/
                /*            left: 8px !important;*/
                /*            right: auto !important;*/
                /*            top:14dvh;*/
                /*            bottom:auto !important;*/
                /*        }*/
                /*}*/
                @media (max-width: 1024px) {
                        .mysidebtnimp.student_chat_sm.phaseBtn {
                            transform: rotate(90deg);
                            transform-origin: bottom left;
                            position: fixed;
                            left: 10px;
                            right: auto;
                            top:14dvh;
                            bottom:auto;
                        }
                    }
                
                @media(max-width:575px){
                    .home_Sports .row .row > div:nth-child(3) {
                        order: 4;
                    }
                    .home_enquiry.footer-fix-enquiry {
                        top: 15%;
                    }
                    .mysidebtnimp.student_chat_sm a, .applynowmobile .applybutton a {
                        font-size: 12px;
                        color: #fff;
                        padding: 10px 12px;
                    }
                    .applynowmobile .applybutton, .enquiry-panel h2{
                        padding: 8px 12px;
                        line-height:unset;
                    }
                    /*.enquiry-panel h2 {*/
                    /*    padding: 0px 12px;*/
                    /*}*/
                }
